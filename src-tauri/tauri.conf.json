{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LL远程",
  "version": "0.1.15",
  "identifier": "cn.llremote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LL远程",
        "width": 1140,
        "height": 844,
        "resizable": true,
        "decorations": true,
        "skipTaskbar": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/LLRemote/wallpapers/**",
          "$EXE/Data/wallpapers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../engines/": "engines/",
      "../notices/": "notices/",
      "../component-tools/": "component-tools/",
      "../LLRemote.EngineHost.exe": "LLRemote.EngineHost.exe",
      "../runtimes/VC/x64/concrt140.dll": "concrt140.dll",
      "../runtimes/VC/x64/msvcp140.dll": "msvcp140.dll",
      "../runtimes/VC/x64/msvcp140_1.dll": "msvcp140_1.dll",
      "../runtimes/VC/x64/msvcp140_2.dll": "msvcp140_2.dll",
      "../runtimes/VC/x64/msvcp140_atomic_wait.dll": "msvcp140_atomic_wait.dll",
      "../runtimes/VC/x64/msvcp140_codecvt_ids.dll": "msvcp140_codecvt_ids.dll",
      "../runtimes/VC/x64/vccorlib140.dll": "vccorlib140.dll",
      "../runtimes/VC/x64/vcruntime140.dll": "vcruntime140.dll",
      "../runtimes/VC/x64/vcruntime140_1.dll": "vcruntime140_1.dll",
      "../runtimes/VC/x64/vcruntime140_threads.dll": "vcruntime140_threads.dll"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
