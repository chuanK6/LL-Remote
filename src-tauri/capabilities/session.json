{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "session",
  "description": "悬浮球仅可移动自己的窗口与控制当前会话。Rust 再次检查窗口身份与会话 ID。",
  "windows": ["session-controls"],
  "permissions": ["core:default", "core:window:allow-set-size", "core:window:allow-set-position", "core:window:allow-start-dragging", "core:window:allow-set-focus"]
}
